<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.lge.ds2.appswitch"
    android:versionCode="1"
    android:versionName="0.1">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="34" />

    <!-- Only for the loopback socket to AppSwitchServer in the root daemon, see
         AppSwitchAccessibilityService's javadoc for why this, and not a file or Binder, is the
         one IPC path from here to root that actually works. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/app_name"
        android:icon="@android:drawable/ic_menu_directions"
        android:allowBackup="false">

        <!-- An AccessibilityService for the same reason as ds2navbar's: it is a real app process
             (so it may add windows, which a bare root app_process may not), and
             TYPE_ACCESSIBILITY_OVERLAY needs no SYSTEM_ALERT_WINDOW grant. -->
        <service
            android:name=".AppSwitchAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
