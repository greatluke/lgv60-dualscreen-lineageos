<?xml version="1.0" encoding="utf-8"?>
<!-- Declares only what the button needs: no event types, no window content. The service exists
     solely to host TYPE_ACCESSIBILITY_OVERLAY windows on both screens; it never inspects the
     accessibility tree or reacts to events, so it requests no capabilities beyond being bound. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:notificationTimeout="100"
    android:canRetrieveWindowContent="false"
    android:description="@string/service_description" />
